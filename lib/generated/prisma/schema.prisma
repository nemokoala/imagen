// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum AuthProvider {
  local
  kakao
}

model User {
  id                     Int              @id @default(autoincrement())
  email                  String           @unique
  password               String?
  nickname               String           @unique
  credits                Int              @default(100) // 기본 100 크레딧
  role                   UserRole         @default(user)
  provider               AuthProvider     @default(local)
  kakaoId                String?          @unique // 카카오 고유 ID
  fcmToken               String? // FCM 토큰
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  profileImageUrl        String?
  loginAttempts          LoginAttempt[]
  generatedImages        GeneratedImage[]
  imageLikes             ImageLike[]
  imageComments          ImageComment[]
  notifications          Notification[]   @relation("UserNotifications")
  triggeredNotifications Notification[]   @relation("NotificationActor")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  failedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GeneratedImage {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  prompt           String   @db.Text
  translatedPrompt String?  @db.Text // 번역된 프롬프트 (번역이 된 경우에만 저장)
  imageUrl         String
  model            String
  size             String   @default("1024x1024")
  ratio            String   @default("1:1")
  editData         String?  @db.Text
  editedImageUrl   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 좋아요, 댓글, 카테고리 관계
  likes         ImageLike[]
  comments      ImageComment[]
  categories    Category[]
  notifications Notification[]

  @@index([userId])
  @@index([createdAt])
  @@index([model])
}

// 이미지 좋아요 모델
model ImageLike {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     GeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  // 한 사용자가 한 이미지에 한 번만 좋아요 가능
  @@unique([userId, imageId])
  @@index([imageId])
  @@index([userId])
}

// 이미지 댓글 모델
model ImageComment {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId       Int
  image         GeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  content       String         @db.Text
  parentId      Int? // 대댓글을 위한 부모 댓글 ID
  parent        ImageComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ImageComment[] @relation("CommentReplies")
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imageId])
  @@index([userId])
  @@index([parentId])
}

// 크레딧 설정 모델 (단일 레코드로 관리)
model CreditSettings {
  id                Int      @id @default(1) // 항상 1번만 사용
  dallE3            Int      @default(20)
  stableDiffusionXl Int      @default(5)
  googleImagen      Int      @default(20)
  nanoBanana        Int      @default(20)
  zImage            Int      @default(10)
  updatedAt         DateTime @updatedAt

  @@map("credit_settings")
}

// LLM 텍스트 모델 설정 (단일 레코드로 관리)
model LlmSettings {
  id          Int      @id @default(1) // 항상 1번만 사용
  provider    String   @default("ollama") // "ollama" | "gemini"
  geminiModel String   @default("gemini-2.0-flash-lite")
  ollamaModel String   @default("gemma3:4b")
  updatedAt   DateTime @updatedAt

  @@map("llm_settings")
}

// 카테고리 모델
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique // 카테고리 이름 (예: "풍경", "인물", "추상화")
  slug      String   @unique // URL-friendly 이름 (예: "landscape", "portrait")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이미지와의 관계 (암묵적 다대다)
  images GeneratedImage[]
}

enum NotificationType {
  LIKE
  COMMENT
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String?
  isRead    Boolean          @default(false)
  imageId   Int?
  image     GeneratedImage?  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  commentId Int?
  comment   ImageComment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}
