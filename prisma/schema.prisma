// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  nickname  String   @unique
  credits   Int      @default(100)  // 기본 100 크레딧
  provider  String   @default("local") // local, kakao
  kakaoId   String?  @unique // 카카오 고유 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileImageUrl String?
  loginAttempts LoginAttempt[]
  generatedImages GeneratedImage[]
  imageLikes ImageLike[]
  imageComments ImageComment[]
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  failedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GeneratedImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  prompt    String   @db.Text
  imageUrl  String
  model     String
  size      String   @default("1024x1024")
  editData  String?   @db.Text
  editedImageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 좋아요와 댓글 관계
  likes     ImageLike[]
  comments  ImageComment[]

  @@index([userId])
  @@index([createdAt])
  @@index([model])
}

// 이미지 좋아요 모델
model ImageLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     GeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // 한 사용자가 한 이미지에 한 번만 좋아요 가능
  @@unique([userId, imageId])
  @@index([imageId])
  @@index([userId])
}

// 이미지 댓글 모델
model ImageComment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     GeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  parentId  Int?     // 대댓글을 위한 부모 댓글 ID
  parent    ImageComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ImageComment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imageId])
  @@index([userId])
  @@index([parentId])
}